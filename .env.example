# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Tag Manager (container ID, e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Session timeout in seconds (default: 2592000 = 30 days)
# AUTH_SESSION_MAX_AGE=2592000

# Email (Resend) — https://resend.com (free tier: 3.000 mails/month)
# Without RESEND_API_KEY the verification / reset links are logged to the server console instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Crisol <noreply@crisol.app>

# Where players write about their data (privacy policy, account deletion).
CONTACT_EMAIL=support@crisol.app

# Database (NeORM resolves the data source from these variables)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=crisol
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Android app (TWA): see /.well-known/assetlinks.json
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=
